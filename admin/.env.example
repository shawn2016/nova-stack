# VITE_API_BASE_URL — 前端 request 使用的 API 基础路径（须与后端 setGlobalPrefix('api') 一致）
#   开发：/api（Vite 仅代理 /api → NestJS）
#   生产：同域留 /api；跨域填完整地址如 https://api.example.com/api
VITE_API_BASE_URL=/api

# VITE_API_PROXY_URL — 仅开发环境 Vite dev server 的代理目标（NestJS 服务地址）
VITE_API_PROXY_URL=http://localhost:3001

# 应用部署基础路径
VITE_BASE_URL=/

# 权限模式：backend = 后端菜单驱动
VITE_ACCESS_MODE=backend

# 开发服务端口
VITE_PORT=5173

# 应用版本
VITE_VERSION=0.1.0

# 生产构建是否移除 console
VITE_DROP_CONSOLE=true
