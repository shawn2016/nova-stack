NODE_ENV=development
PORT=3000
SKIP_EXTERNAL_SERVICES=false
# MySQL（pnpm seed 需要）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nova_stack
# 跳过 seed：SKIP_SEED=true
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# 文件上传（默认本地模式）
OSS_ENABLED=false
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
APP_PUBLIC_URL=http://localhost:3000
UPLOAD_MAX_SIZE=5242880
