# Staging 示例：与 production 相同，禁用 TypeORM synchronize
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://admin.staging.example.com
SKIP_EXTERNAL_SERVICES=false
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=nova_stack
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=change-me-staging
JWT_EXPIRES_IN=7d
OSS_ENABLED=false
APP_PUBLIC_URL=https://api.staging.example.com
UPLOAD_MAX_SIZE=5242880
